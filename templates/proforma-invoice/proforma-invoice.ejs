<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= firm.name %> - Proforma Invoice <%= proforma.proforma_no %></title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
    @page { size: A4 portrait; margin: 0; }
    * { box-sizing: border-box; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      margin: 0; padding: 0; color: #1e293b; font-size: 7.8px; line-height: 1.32; background: #ffffff;
      -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; text-rendering: optimizeLegibility;
    }
    .page-sheet {
      width: 210mm; min-height: 297mm; max-height: 297mm; margin: 0 auto; background: #ffffff;
      padding: 6mm 7.5mm; display: flex; flex-direction: column; overflow: hidden; page-break-after: always; position: relative;
    }
    @media print { body { background: transparent; } .page-sheet { margin: 0; page-break-after: always; } }
    
    .doc-frame {
      border: 1.5px solid #e2e8f0; border-top: 3.5px solid #dc2626; border-radius: 4px;
      display: flex; flex-direction: column; flex: 1; height: 100%; overflow: hidden; background: #ffffff;
      box-shadow: 0 1px 4px rgba(0,0,0,0.03);
    }
    
    /* Top Bar */
    .top-bar {
      background: #ffffff; color: #1e293b; padding: 5px 10px; display: flex; justify-content: space-between; align-items: center;
      border-bottom: 1.5px solid #f1f5f9; flex-wrap: nowrap;
    }
    .top-left-group { display: flex; align-items: center; flex-wrap: nowrap; gap: 8px; }
    .top-title { font-size: 8.5px; font-weight: 700; letter-spacing: 0.4px; text-transform: uppercase; color: #0f172a; white-space: nowrap; }
    .top-tag { background: #fef2f2; color: #dc2626; border: 1px solid #fecdd3; font-size: 7px; font-weight: 600; padding: 1.5px 6px; border-radius: 3px; letter-spacing: 0.2px; white-space: nowrap; }
    .top-meta { font-size: 8px; color: #64748b; font-weight: 500; white-space: nowrap; }
    .top-meta b { color: #0f172a; font-weight: 600; }

    /* Header Grid */
    .header-grid { display: flex; border-bottom: 1px solid #e2e8f0; }
    .co-box { flex: 1.35; padding: 5px 10px; border-right: 1px solid #e2e8f0; display: flex; align-items: center; gap: 10px; }
    .co-info { flex: 1; }
    .co-name { font-size: 13px; font-weight: 700; color: #dc2626; letter-spacing: 0.3px; margin: 0; }
    .co-sub { font-size: 7px; font-weight: 600; color: #475569; text-transform: uppercase; margin-bottom: 2px; letter-spacing: 0.2px; }
    .co-details { font-size: 7.5px; color: #475569; line-height: 1.3; }
    .co-details b { font-weight: 600; color: #1e293b; }

    .meta-box { flex: 0.85; padding: 5px 10px; font-size: 7.5px; background: #fafbfc; }
    .meta-row { display: flex; justify-content: space-between; margin-bottom: 2px; }
    .meta-lbl { color: #64748b; font-weight: 500; }
    .meta-val { color: #0f172a; font-weight: 600; }

    /* Client Grid */
    .client-grid { display: flex; border-bottom: 1px solid #e2e8f0; background: #ffffff; }
    .client-col { flex: 1; padding: 5px 10px; font-size: 7.5px; line-height: 1.35; }
    .client-col.bordered { border-right: 1px solid #e2e8f0; }
    .client-title { font-size: 7px; font-weight: 700; color: #dc2626; text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 2px; }
    .client-name { font-size: 9.5px; font-weight: 700; color: #0f172a; margin-bottom: 2px; }

    /* Table Section */
    .table-container { flex: 1; display: flex; flex-direction: column; overflow: hidden; background: #ffffff; }
    table.data-table { width: 100%; border-collapse: collapse; font-size: 7.5px; height: 100%; }
    table.data-table th {
      background: #fef2f2; color: #991b1b; font-weight: 600; font-size: 7px; text-transform: uppercase;
      letter-spacing: 0.2px; padding: 4.5px 5px; border-top: 1.5px solid #dc2626; border-bottom: 1.5px solid #dc2626;
      border-right: 1px solid #fee2e2;
    }
    table.data-table th:last-child { border-right: none; }
    table.data-table td {
      padding: 4px 5px; border-bottom: 1px solid #f1f5f9; border-right: 1px solid #f8fafc;
      vertical-align: top; color: #1e293b; line-height: 1.3;
    }
    table.data-table td:last-child { border-right: none; }
    table.data-table tr:nth-child(even) td { background-color: #fafbfc; }

    .filler-row { height: 100%; }
    .filler-row td { border-bottom: none; border-color: #f1f5f9; background: #ffffff; }

    .text-center { text-align: center; }
    .text-right { text-align: right; }
    .text-left { text-align: left; }
    .font-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }

    .badge-red {
      display: inline-block; padding: 1px 4.5px; border-radius: 2px; font-size: 6.5px; font-weight: 600; letter-spacing: 0.2px;
      background: #fef2f2; color: #dc2626; border: 0.5px solid #fecdd3;
    }

    /* TIER 1: Summary Grid (Payment Destination on Left, Calculation on Right) */
    .summary-grid {
      display: flex; border-top: 1.5px solid #e2e8f0; border-bottom: 1px solid #e2e8f0; background: #ffffff;
    }
    .words-box {
      flex: 1.25; padding: 6px 10px; border-right: 1px solid #e2e8f0; display: flex; flex-direction: column; justify-content: space-between;
    }
    .words-title {
      font-size: 6.8px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.3px; margin-bottom: 1px;
    }
    .words-text {
      font-size: 8px; font-weight: 600; color: #0f172a; line-height: 1.3;
    }

    .bank-box {
      margin-top: 4px; padding: 4.5px 7px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 3px; font-size: 7px;
    }
    .bank-title-row {
      display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.5px;
    }
    .bank-title {
      font-weight: 700; color: #991b1b; text-transform: uppercase; letter-spacing: 0.25px; font-size: 7px;
    }
    .bank-info-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 2px 8px; font-size: 6.8px; color: #1e293b; line-height: 1.35;
    }
    .bank-info-grid .lbl-k { color: #64748b; font-weight: 500; }
    .bank-info-grid .lbl-v { font-weight: 600; color: #0f172a; }
    .remittance-note {
      margin-top: 3px; padding-top: 2.5px; border-top: 0.5px dashed #fecaca; font-size: 6.6px; color: #991b1b; line-height: 1.3;
    }
    .remittance-note b { font-weight: 700; }

    .calc-box {
      flex: 0.95; padding: 6px 10px; font-size: 7.5px; background: #fafbfc; display: flex; flex-direction: column; justify-content: space-between;
    }
    .calc-row {
      display: flex; justify-content: space-between; margin-bottom: 2px; font-weight: 500;
    }
    .calc-row.grand {
      border-top: 1.5px solid #dc2626; padding-top: 3px; margin-top: 2px; font-size: 9px; font-weight: 700; color: #dc2626;
    }

    .advance-card {
      margin-top: 4px; padding: 4px 6px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 3px;
    }
    .adv-header {
      display: flex; justify-content: space-between; align-items: center;
    }
    .adv-title {
      font-size: 7.2px; font-weight: 700; color: #991b1b; text-transform: uppercase; letter-spacing: 0.2px;
    }
    .adv-row {
      display: flex; justify-content: space-between; align-items: center;
    }
    .adv-sub-lbl {
      font-size: 6.8px; color: #64748b; font-weight: 600;
    }
    .adv-val {
      font-size: 8.5px; font-weight: 700; color: #dc2626;
    }
    .adv-bal {
      font-size: 6.8px; color: #64748b; margin-top: 2px; padding-top: 2px; border-top: 0.5px dashed #fecaca;
    }

    /* TIER 2: Footer Grid (Terms on Left 72%, Signatory on Right 28%) */
    .footer-grid {
      display: flex; padding: 6px 10px; font-size: 7px; background: #ffffff; justify-content: space-between; align-items: flex-end;
    }
    .terms-container {
      max-width: 72%; display: flex; flex-direction: column; gap: 2.5px;
    }
    .terms-badge {
      font-size: 7.2px; font-weight: 700; text-transform: uppercase; color: #dc2626; letter-spacing: 0.3px;
      display: inline-block; margin-bottom: 1px;
    }
    .comm-specs-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 3px 12px; font-size: 7.2px; color: #475569; margin: 3px 0 4px 0;
    }
    .comm-specs-grid .spec-lbl { color: #64748b; font-weight: 600; }
    .comm-specs-grid .spec-val { color: #0f172a; font-weight: 600; }
    
    .declaration-note {
      font-size: 6.8px; color: #64748b; font-style: italic; line-height: 1.3; margin-top: 1px;
    }

    .sign-box {
      text-align: center; width: 145px; display: flex; flex-direction: column; align-items: center;
    }
    .sign-company {
      font-size: 7px; font-weight: 600; color: #475569; text-transform: uppercase; letter-spacing: 0.2px; margin-bottom: 2px;
    }
    .sign-firm-name {
      color: #dc2626; font-weight: 700;
    }
    .sign-space {
      height: 26px;
    }
    .sign-line {
      border-top: 1px dashed #ef4444; width: 100%; padding-top: 2px; font-size: 7px; font-weight: 600; color: #64748b;
    }
  </style>
</head>
<body>
  <div class="page-sheet">
    <div class="doc-frame">
      
      <!-- Top Bar -->
      <div class="top-bar">
        <div class="top-left-group">
          <span class="top-title">PROFORMA INVOICE</span>
          <span class="top-tag">ADVANCE COMMERCIAL BILL</span>
        </div>
        <div class="top-meta">
          PI No: <b style="color: #dc2626;"><%= proforma.proforma_no %></b> &nbsp;|&nbsp; Date: <b><%= proforma.formatted_date %></b>
        </div>
      </div>

      <!-- Header Grid -->
      <div class="header-grid">
        <div class="co-box">
          <% if (firm.logo_url) { %>
            <img src="<%= firm.logo_url %>" alt="Logo" style="max-height: 40px; max-width: 85px; object-fit: contain;">
          <% } else { %>
            <svg width="36" height="36" viewBox="0 0 100 100" style="flex-shrink: 0;">
              <polygon points="50,4 88,26 88,74 50,96 12,74 12,26" fill="#fef2f2" stroke="#dc2626" stroke-width="5" stroke-linejoin="round"/>
              <text x="50" y="57" font-family="'Inter', -apple-system, sans-serif" font-weight="900" font-size="22" fill="#dc2626" text-anchor="middle" letter-spacing="1">KS</text>
              <text x="50" y="70" font-family="'Inter', -apple-system, sans-serif" font-weight="700" font-size="8" fill="#991b1b" text-anchor="middle" letter-spacing="0.5">MFG</text>
            </svg>
          <% } %>
          <div class="co-info">
            <h1 class="co-name"><%= firm.name %></h1>
            <% if (firm.subtitle) { %><div class="co-sub"><%= firm.subtitle %></div><% } %>
            <div class="co-details">
              <% if (firm.address) { %><div><%= firm.address %></div><% } %>
              <div>
                <% if (firm.gstin) { %><b>GSTIN:</b> <%= firm.gstin %><% } %>
                <% if (firm.phone) { %> &nbsp;|&nbsp; <b>Ph:</b> <%= firm.phone %><% } %>
                <% if (firm.email) { %> &nbsp;|&nbsp; <b>Email:</b> <%= firm.email %><% } %>
              </div>
            </div>
          </div>
        </div>

        <div class="meta-box">
          <div class="meta-row"><span class="meta-lbl">Proforma No:</span><span class="meta-val font-mono" style="color: #dc2626; font-weight: 700;"><%= proforma.proforma_no %></span></div>
          <div class="meta-row"><span class="meta-lbl">Date:</span><span class="meta-val"><%= proforma.formatted_date %></span></div>
          <div class="meta-row"><span class="meta-lbl">Due / Validity:</span><span class="meta-val"><%= proforma.formatted_due_date %></span></div>
          <% if (proforma.order_ref_no) { %>
            <div class="meta-row"><span class="meta-lbl">Buyer PO / Ref:</span><span class="meta-val"><%= proforma.order_ref_no %></span></div>
          <% } %>
          <% if (proforma.quotation_no) { %>
            <div class="meta-row"><span class="meta-lbl">Quotation Ref:</span><span class="meta-val font-mono" style="color: #dc2626;">#<%= proforma.quotation_no %></span></div>
          <% } %>
          <% if (proforma.place_of_supply) { %>
            <div class="meta-row"><span class="meta-lbl">Place of Supply:</span><span class="meta-val"><%= proforma.place_of_supply %></span></div>
          <% } %>
        </div>
      </div>

      <!-- Client Details Grid -->
      <div class="client-grid">
        <div class="client-col bordered">
          <div class="client-title">Billed To (Customer):</div>
          <div class="client-name"><%= proforma.customer_name %></div>
          <% if (proforma.billing_address) { %><div><%= proforma.billing_address %></div><% } %>
          <% if (proforma.gst_number) { %><div style="margin-top: 1.5px;"><b>GSTIN:</b> <%= proforma.gst_number %></div><% } %>
          <% if (proforma.contact_person || proforma.contact_phone) { %>
            <div style="margin-top: 1px;"><b>Contact:</b> <%= proforma.contact_person || '' %> <%= proforma.contact_phone ? '(' + proforma.contact_phone + ')' : '' %></div>
          <% } %>
        </div>

        <div class="client-col">
          <div class="client-title">Shipped / Dispatched To:</div>
          <div><%= proforma.shipping_address || proforma.billing_address || 'Same as Billing Address' %></div>
          <% if (proforma.dispatch_through) { %>
            <div style="margin-top: 2px;"><b>Dispatch Via:</b> <%= proforma.dispatch_through %></div>
          <% } %>
          <% if (proforma.destination) { %>
            <div><b>Destination:</b> <%= proforma.destination %></div>
          <% } %>
        </div>
      </div>

      <!-- Table Section -->
      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width: 25px;" class="text-center">#</th>
              <th>Description of Goods / Products & Drawing No</th>
              <th style="width: 65px;" class="text-center">HSN/SAC</th>
              <th style="width: 45px;" class="text-center">Qty</th>
              <th style="width: 35px;" class="text-center">Unit</th>
              <th style="width: 70px;" class="text-right">Rate (₹)</th>
              <% if (proforma.has_item_discount) { %>
                <th style="width: 45px;" class="text-right">Disc</th>
              <% } %>
              <th style="width: 75px;" class="text-right">Taxable (₹)</th>
              <th style="width: 45px;" class="text-center">GST %</th>
              <th style="width: 80px;" class="text-right">Total (₹)</th>
            </tr>
          </thead>
          <tbody>
            <% proforma.items.forEach(function(item, idx) { %>
              <tr>
                <td class="text-center"><%= idx + 1 %></td>
                <td>
                  <div style="font-weight: 600; color: #0f172a;"><%= item.itemName || item.item_name %></div>
                  <% if (item.drawingNumber || item.drawing_number) { %>
                    <div style="margin-top: 1.5px;">
                      <span class="badge-red">DWG: <%= item.drawingNumber || item.drawing_number %></span>
                    </div>
                  <% } %>
                  <% if (item.description) { %>
                    <div style="font-size: 6.8px; color: #64748b; margin-top: 1px;"><%= item.description %></div>
                  <% } %>
                </td>
                <td class="text-center font-mono"><%= item.hsnSacCode || item.hsn_sac_code || '-' %></td>
                <td class="text-center font-mono"><b><%= item.qty %></b></td>
                <td class="text-center"><%= item.unit || 'Nos' %></td>
                <td class="text-right font-mono"><%= item.formatted_rate %></td>
                <% if (proforma.has_item_discount) { %>
                  <td class="text-right font-mono"><%= item.discount_percent > 0 ? item.discount_percent + '%' : item.formatted_discount_amount %></td>
                <% } %>
                <td class="text-right font-mono"><%= item.formatted_taxable %></td>
                <td class="text-center font-mono"><%= item.tax_rate %>%</td>
                <td class="text-right font-mono" style="font-weight: 600;"><%= item.formatted_total %></td>
              </tr>
            <% }); %>
            <tr class="filler-row">
              <td colspan="<%= proforma.has_item_discount ? 10 : 9 %>"></td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- TIER 1: Summary Grid (Payment Destination on Left, Calculation on Right) -->
      <div class="summary-grid">
        <!-- Left Column: Amount in Words + Bank Remittance Details -->
        <div class="words-box">
          <div class="words-wrapper">
            <div class="words-title">Amount Chargeable (in words):</div>
            <div class="words-text"><%= proforma.amount_in_words %></div>
          </div>

          <% if (bank && bank.account_number) { %>
            <div class="bank-box">
              <div class="bank-title-row">
                <span class="bank-title">Bank Remittance Details (NEFT / RTGS):</span>
                <span class="badge-red">FOR ADVANCE REMITTANCE</span>
              </div>
              <div class="bank-info-grid">
                <div><span class="lbl-k">Bank:</span> <span class="lbl-v"><%= bank.bank_name %></span></div>
                <div><span class="lbl-k">Branch:</span> <span class="lbl-v"><%= bank.branch_name || 'Main Branch' %></span></div>
                <div><span class="lbl-k">A/c No:</span> <span class="lbl-v font-mono font-bold"><%= bank.account_number %></span></div>
                <div><span class="lbl-k">IFSC:</span> <span class="lbl-v font-mono font-bold" style="color: #dc2626;"><%= bank.ifsc_code %></span></div>
              </div>
              <% if (proforma.special_notes) { %>
                <div class="remittance-note">
                  <b>Note:</b> <%= proforma.special_notes %>
                </div>
              <% } %>
            </div>
          <% } %>
        </div>

        <!-- Right Column: Subtotal, Taxes, Grand Total, and Advance Card -->
        <div class="calc-box">
          <div>
            <div class="calc-row"><span class="meta-lbl">Sub Total:</span><span class="font-mono">₹<%= proforma.formatted_sub_total %></span></div>
            <% if (proforma.discount_amount > 0) { %>
              <div class="calc-row"><span class="meta-lbl">Discount:</span><span class="font-mono">- ₹<%= proforma.formatted_discount_amount %></span></div>
            <% } %>
            <div class="calc-row"><span class="meta-lbl">Taxable Value:</span><span class="font-mono">₹<%= proforma.formatted_taxable_amount %></span></div>
            
            <% if (proforma.is_interstate) { %>
              <div class="calc-row"><span class="meta-lbl">Integrated GST (IGST):</span><span class="font-mono">₹<%= proforma.formatted_igst %></span></div>
            <% } else { %>
              <div class="calc-row"><span class="meta-lbl">Central GST (CGST):</span><span class="font-mono">₹<%= proforma.formatted_cgst %></span></div>
              <div class="calc-row"><span class="meta-lbl">State GST (SGST):</span><span class="font-mono">₹<%= proforma.formatted_sgst %></span></div>
            <% } %>

            <% if (proforma.other > 0) { %>
              <div class="calc-row"><span class="meta-lbl">Freight / Other:</span><span class="font-mono">+ ₹<%= proforma.formatted_other %></span></div>
            <% } %>

            <% if (proforma.round_off != 0) { %>
              <div class="calc-row"><span class="meta-lbl">Round Off:</span><span class="font-mono"><%= proforma.round_off > 0 ? '+ ' : '' %>₹<%= proforma.formatted_round_off %></span></div>
            <% } %>

            <div class="calc-row grand">
              <span>PROFORMA TOTAL:</span>
              <span class="font-mono">₹<%= proforma.formatted_total %></span>
            </div>
          </div>

          <!-- Highlighted Advance Payment Requested Box -->
          <div class="advance-card">
            <div class="adv-header">
              <span class="adv-title">Advance Requested:</span>
              <span class="badge-red"><%= proforma.advance_percent %>% REQUIRED</span>
            </div>
            <div class="adv-row" style="margin-top: 2px;">
              <span class="adv-sub-lbl">Advance Payable Now:</span>
              <span class="adv-val font-mono">₹<%= proforma.formatted_advance_requested %></span>
            </div>
            <% if (proforma.has_advance_configured && proforma.balance_payable > 0) { %>
              <div class="adv-row adv-bal">
                <span>Balance on Dispatch:</span>
                <span class="font-mono" style="font-weight: 600; color: #1e293b;">₹<%= proforma.formatted_balance_payable %></span>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- TIER 2: Footer Grid (Commercial Terms on Left, Signatory on Right) -->
      <div class="footer-grid">
        <div class="terms-container">
          <div class="terms-badge">Commercial Terms:</div>
          
          <div class="comm-specs-grid">
            <div><span class="spec-lbl">Payment Terms:</span> <span class="spec-val"><%= proforma.payment_terms || 'Advance against Proforma Invoice' %></span></div>
            <div><span class="spec-lbl">Delivery Schedule:</span> <span class="spec-val"><%= proforma.delivery_period || 'As agreed' %></span></div>
            <div><span class="spec-lbl">Freight & Transport:</span> <span class="spec-val"><%= proforma.freight_basis || 'Ex-Works / At Actuals' %></span></div>
            <div><span class="spec-lbl">Warranty Coverage:</span> <span class="spec-val"><%= proforma.warranty_terms || 'Immediate check upon receipt' %></span></div>
          </div>

          <!-- Declaration Note -->
          <div class="declaration-note">
            <strong>Declaration:</strong> This is a <u>Proforma Invoice</u> and NOT a formal GST Tax Invoice. Production/dispatch will commence upon receipt of the advance payment specified above into our bank account. Official GST Tax Invoice and E-Way Bill will accompany the consignment upon dispatch.
          </div>
        </div>

        <div class="sign-box">
          <div class="sign-company">For <span class="sign-firm-name"><%= firm.name %></span></div>
          <div class="sign-space"></div>
          <div class="sign-line">Authorized Signatory</div>
        </div>
      </div>

    </div>
  </div>
</body>
</html>
